<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Service Certificate</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#0f172a; /* deep navy */
      --card:#0b1220;
      --accent1:#7c3aed; /* violet */
      --accent2:#06b6d4; /* teal */
      --muted:#94a3b8;
      --paper:#ffffff;
    }

    html,body{height:100%;margin:0;padding:0;font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;}

    /* Page sizing for PDF printing (A4 landscape option commented) */
    @page { size: A4 portrait; margin: 24mm }

    body{
      background: linear-gradient(180deg, rgba(15,23,42,1) 0%, rgba(7,10,20,1) 100%);
      color: var(--paper);
      -webkit-font-smoothing:antialiased;
      padding: 40px 32px;
    }

    .certificate-wrapper{
      max-width: 1200px;
      margin: 0 auto;
      /*background: red;*/
      background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(2,6,23,0.6);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.04);
    }

    header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:28px 36px;
      background: linear-gradient(90deg, rgba(124,58,237,0.16), rgba(6,182,212,0.06));
      border-bottom: 1px solid rgba(255,255,255,0.02);
    }

    .brand{
      display:flex;gap:16px;align-items:center
    }

    .logo{
      width:72px;height:72px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--accent1),var(--accent2));font-weight:800;color:white;font-size:22px
    }

    .company{
      line-height:1;
    }
    .company h1{margin:0;font-size:20px;letter-spacing:0.2px}
    .company p{margin:0;font-size:12px;color:var(--muted)}

    .meta{ text-align:right }
    .meta .title{font-weight:700;color:var(--paper)}
    .meta .small{font-size:12px;color:var(--muted)}

    .content {
      display: grid;
      grid-template-columns: 1fr 1fr; /* proportional instead of fixed */
      gap: 20px;
      padding: 24px;
    }

    .left{
      background:transparent;padding:6px 0
    }

    .certificate-card{
      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border-radius:12px;padding:20px;border:1px solid rgba(255,255,255,0.03)
    }

    .headline{font-size:22px;font-weight:800;margin:8px 0}
    .sub{color:var(--muted);font-size:13px;margin-bottom:12px}

    .details{display:flex;gap:12px;flex-wrap:wrap}
    .chip{background:rgba(255,255,255,0.02);padding:10px 12px;border-radius:8px;font-size:13px;color:var(--muted);border:1px solid rgba(255,255,255,0.01)}

    .items{margin-top:18px;border-radius:8px;overflow:hidden}
    table{width:100%;border-collapse:collapse;background:transparent}
    thead th{background:linear-gradient(90deg, rgba(124,58,237,0.14), rgba(6,182,212,0.06));padding:12px 14px;text-align:left;font-weight:700;font-size:13px}
    tbody td{padding:12px 14px;border-top:1px dashed rgba(255,255,255,0.03);font-size:13px}

    .right{min-width:320px}

    .summary{display:flex;flex-direction:column;gap:12px}
    .summary .row{display:flex;justify-content:space-between;align-items:center}
    .summary .label{color:var(--muted)}
    .total{font-size:20px;font-weight:800;color:var(--accent2)}

    .signature-area{display:flex;justify-content:space-between;align-items:center;margin-top:18px}
    .sig{display:flex;flex-direction:column;align-items:flex-start}
    .sig .name{font-weight:700}
    .sig .title{font-size:12px;color:var(--muted)}

    footer{padding:20px 36px;background:linear-gradient(90deg, rgba(0,0,0,0.02), rgba(255,255,255,0.01));border-top:1px solid rgba(255,255,255,0.02);display:flex;justify-content:space-between;align-items:center}
    .smallprint{color:var(--muted);font-size:12px}

    /* Printable friendly adjustments */
    @media print{
      body{padding:0}
      .certificate-wrapper{box-shadow:none;border:none;margin:0}
    }

    /* small screens */
    @media (max-width:800px){
      .content{grid-template-columns:1fr;}
      .meta{text-align:left}
    }
  </style>
</head>
<body>
  <div class="certificate-wrapper">
    <header>
      <div class="brand">
        <div class="logo">SR</div>
        <div class="company">
          <h1>Superior Repair Works</h1>
          <p>Vehicle Service & Maintenance Certificate</p>
        </div>
      </div>

      <div class="meta">
        <div class="title">Certificate ID: <strong>{{interaction.interaction_id}}</strong></div>
        <div class="small">Issued: {{interaction.interaction_date}}</div>
      </div>
    </header>

    <div class="content">
      <div class="left">
        <div class="certificate-card">
          <div class="headline">Certificate of Service Completion</div>
          <div class="sub">This certifies that the vehicle with VIN <strong>{{interaction.service_record.vin}}</strong> has received the service described below.</div>

          <div class="details">
            <div class="chip">Vehicle ID: <strong style="color:var(--paper);margin-left:6px">{{interaction.vehicle_id}}</strong></div>
            <div class="chip">Mechanic: <strong style="color:var(--paper);margin-left:6px">{{interaction.mechanic_id}}</strong></div>
            <div class="chip">Service Type: <strong style="color:var(--paper);margin-left:6px">{{interaction.service_record.service_type}}</strong></div>
            <div class="chip">Mileage: <strong style="color:var(--paper);margin-left:6px">{{interaction.service_record.mileage}}</strong></div>
          </div>

          <div class="items">
            <table>
              <thead>
                <tr>
                  <th>Item / Service</th>
                  <th>Desc</th>
                  <th style="text-align:right">Cost</th>
                </tr>
              </thead>
              <tbody>
                {{#each interaction.invoice.items}}
                  <tr>
                    <td>{{description}}</td>
                    <td>{{item_id}}</td>
                    <td style="text-align:right">{{total_price}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px">
            <div>
              <div style="font-size:12px;color:var(--muted)">Remarks</div>
              <div style="margin-top:6px">{{interaction.invoice.remarks}}</div>
            </div>

            <div style="text-align:right">
              <div style="font-size:12px;color:var(--muted)">Status</div>
              <div style="margin-top:6px;font-weight:800;color:var(--accent1)">{{interaction.invoice.payment_status}}</div>
            </div>
          </div>

          <div class="signature-area">
            <div class="sig">
              <div class="name">{{interaction.mechanic_id}}</div>
              <div class="title">Certified Mechanic</div>
            </div>

            <div class="sig" style="align-items:flex-end">
              <div class="name">Certiride</div>
              <div class="title">Authorized Signatory</div>
            </div>
          </div>
        </div>
      </div>

      <div class="right">
        <div class="certificate-card">
          <div style="display:flex;align-items:center;justify-content:space-between">
            <div>
              <div style="font-size:12px;color:var(--muted)">Invoice</div>
              <div style="font-weight:800;font-size:16px;margin-top:6px">#{{interaction.invoice.invoice_number}}</div>
              <div style="font-size:12px;color:var(--muted);margin-top:4px">Date: {{interaction.invoice.invoice_date}}</div>
            </div>
            <div style="text-align:right">
              <div style="font-size:12px;color:var(--muted)">Subtotal</div>
              <div style="font-weight:700;margin-top:6px">{{interaction.invoice.sub_total}}</div>
            </div>
          </div>

          <div style="height:1px;background:linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0));margin:12px 0"></div>

          <div class="summary">
            <div class="row"><div class="label">Discount</div><div>{{interaction.invoice.discount}}</div></div>
            <div class="row"><div class="label">Tax</div><div>{{interaction.invoice.tax}}</div></div>
            <div class="row" style="border-top:1px dashed rgba(255,255,255,0.03);padding-top:8px"><div class="label">Total</div><div class="total">{{interaction.invoice.total}}</div></div>
          </div>

          <div style="height:1px;background:linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0));margin:12px 0"></div>

          <div style="display:flex;gap:10px;align-items:center">
            <div style="flex:1">
              <div style="font-size:12px;color:var(--muted)">Attachments</div>
              <div style="margin-top:8px;font-size:13px">
                <!-- Loop attachments and show names or thumbnails -->
                {{#each interaction.invoice.attachments}}
                  <div>• {{file_name}}</div>
                {{/each}}
              </div>
            </div>
            <div style="width:88px;height:88px;border-radius:8px;background:linear-gradient(135deg,var(--accent1),var(--accent2));display:flex;align-items:center;justify-content:center">
              <div style="font-weight:800">QR</div>
            </div>
          </div>

        </div>

        <div style="margin-top:16px;padding:12px;border-radius:10px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.005));border:1px solid rgba(255,255,255,0.02)">
          <div style="font-size:12px;color:var(--muted)">Diagnostic Summary</div>
          <div style="margin-top:8px;font-size:13px">Sample summery</div>
        </div>

      </div>
    </div>

    <footer>
      <div class="smallprint">Service performed in accordance with company standards. Contact: support@superiorrepair.example</div>
      <div class="smallprint">Certificate generated on {{genTime}}</div>
    </footer>
  </div>
</body>
</html>
